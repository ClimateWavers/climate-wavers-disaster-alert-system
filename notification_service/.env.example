# notification_service — ALL of these are required at startup (Joi)
# cp .env.example .env

PORT=3000
AMQP_URL=amqp://admin:admin@localhost:5672/

SERVER_PORT=3000
SERVER_HOST=localhost
SERVER_PROTOCOL=http
SERVER_SECRET=change-me-local-server-secret

# SMTP (Gmail example: use an app password)
MAIL_USER=your@email.com
MAIL_PASS=your-app-password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SERVICE=gmail

# Firebase (required)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

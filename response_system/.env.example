# response_system — copy to .env
# cp .env.example .env

PORT=3004
AMQP_URL=amqp://admin:admin@localhost:5672/

# LLM (at least one for chat features)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ML models (Flask on :5000)
ANALYSIS_MODEL_URL=http://127.0.0.1:5000/api/v1/analysis
RECOGNITION_MODEL_URL=http://127.0.0.1:5000/api/v1/recognition

# Firebase (optional for this service)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

# Cloudinary (optional)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# IP lookup (optional)
# IP_INFO_URL=https://ipinfo.io
# IP_INFO_TOKEN=

# DISAX_AI_ID=000000
# DISAX_AI_USERNAME=Waver-X AI
# DEFAULT_JOB_TIME_UNIT=sec
# DEFAULT_JOB_TIME_VALUE=20

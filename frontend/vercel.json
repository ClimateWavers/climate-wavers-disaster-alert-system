{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/auth/google",
      "destination": "https://oauth.climatewavers.me/api/v1/auth/google"
    },
    {
      "source": "/api/v1/auth/new-google",
      "destination": "https://oauth.climatewavers.me/api/v1/auth/new-google"
    },
    {
      "source": "/api/v1/auth/facebook",
      "destination": "https://oauth.climatewavers.me/api/v1/auth/facebook"
    },
    {
      "source": "/api/v1/auth/linkedin",
      "destination": "https://oauth.climatewavers.me/api/v1/auth/linkedin"
    },
    {
      "source": "/api/v1/auth/github",
      "destination": "https://oauth.climatewavers.me/api/v1/auth/github"
    },
    {
      "source": "/api/v1/auth/google/(.*)",
      "destination": "https://oauth.climatewavers.me/api/v1/auth/google/$1"
    },
    {
      "source": "/api/v1/auth/github/(.*)",
      "destination": "https://oauth.climatewavers.me/api/v1/auth/github/$1"
    },
    {
      "source": "/api/v1/auth/linkedin/(.*)",
      "destination": "https://oauth.climatewavers.me/api/v1/auth/linkedin/$1"
    },
    {
      "source": "/api/v1/auth/facebook/(.*)",
      "destination": "https://oauth.climatewavers.me/api/v1/auth/facebook/$1"
    },
    {
      "source": "/api/v1/auth/(.*)",
      "destination": "https://climatewavers-backend-w8bw.onrender.com/api/v1/auth/$1"
    },
    {
      "source": "/api/v1/chats/(.*)",
      "destination": "https://climate-wavers-iyvx.onrender.com/api/v1/chats/$1"
    },
    {
      "source": "/api/v1/disasters/(.*)",
      "destination": "https://climate-wavers-iyvx.onrender.com/api/v1/disasters/$1"
    },
    {
      "source": "/api/v1/disasters",
      "destination": "https://climate-wavers-iyvx.onrender.com/api/v1/disasters"
    },
    {
      "source": "/api/v1/chats",
      "destination": "https://climate-wavers-iyvx.onrender.com/api/v1/chats"
    },
    {
      "source": "/api/v1/posts/(.*)",
      "destination": "https://climate-wavers-iyvx.onrender.com/api/v1/posts/$1"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "https://climatewavers-backend-w8bw.onrender.com/api/v1/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://climatewavers-backend-w8bw.onrender.com/media/$1"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}